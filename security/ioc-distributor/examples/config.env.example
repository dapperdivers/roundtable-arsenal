# IOC Distributor Configuration
# Copy to config.env and update with your settings

# OpenCTI Configuration
OPENCTI_URL="https://opencti.domain.com"
OPENCTI_TOKEN="your-token-here"

# MISP Configuration
MISP_URL="https://misp.domain.com"
MISP_KEY="your-api-key-here"

# SIEM Webhook Configuration
SIEM_WEBHOOK="https://siem.domain.com/api/v1/iocs"
SIEM_WEBHOOK_TOKEN="Bearer your-token-here"

# Syslog Configuration
SYSLOG_SERVER="192.168.1.100:514"

# Suricata IDS Configuration
SURICATA_SFTP="ids-admin@192.168.1.50:/etc/suricata/rules/"
SURICATA_SSH_KEY="/home/user/.ssh/id_rsa_suricata"
SURICATA_RELOAD=1  # Automatically reload rules after upload

# File Share Configuration
FILE_SHARE_PATH="/mnt/security-share/iocs"

# Export Settings
DEFAULT_DAYS=7
DEFAULT_CONFIDENCE=70
IOC_TTL_DAYS=30

# Distribution Settings
DISTRIBUTION_LOG="/var/log/ioc-distributor.log"
