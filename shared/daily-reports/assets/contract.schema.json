{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knight Daily Report",
  "description": "Output contract for roundtable knight daily briefings",
  "type": "object",
  "required": ["knight", "run_id", "report_type", "timestamp", "summary", "sections", "highlights", "follow_up_needed", "follow_up_questions"],
  "properties": {
    "knight": {
      "type": "string",
      "description": "Knight identifier"
    },
    "run_id": {
      "type": "string",
      "pattern": "^daily-\\d{4}-\\d{2}-\\d{2}$",
      "description": "Run identifier in format daily-YYYY-MM-DD"
    },
    "report_type": {
      "type": "string",
      "enum": ["daily-briefing"],
      "description": "Report type identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 generation timestamp"
    },
    "summary": {
      "type": "string",
      "description": "2-3 sentence executive summary"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "priority", "content", "data_sources", "confidence"],
        "properties": {
          "title": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "content": { "type": "string", "description": "Markdown-formatted content" },
          "data_sources": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "follow_up_needed": { "type": "boolean" },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
